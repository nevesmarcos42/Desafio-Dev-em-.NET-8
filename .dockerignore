# Docker ignore patterns

# Build results
bin/
obj/
out/
publish/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# IDE folders
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
!README.md

# Test results
TestResults/
*.trx

# NuGet
*.nupkg
*.snupkg
.nuget/

# Application data
data/
logs/
*.log
